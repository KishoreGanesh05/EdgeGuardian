# Edge-Guardian environment configuration (Stage 2).
# Copy to `.env` and fill in only what you need. EVERY value is optional —
# `python main.py --demo` runs fully without any of these.

# ── Logging ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Simulation ───────────────────────────────────────────────────────────
DEMO_ASSET_COUNT=25
DEMO_SEED=42

# ── GPT-5 agent (OPTIONAL) ───────────────────────────────────────────────
# If unset, the agent uses its built-in deterministic backend (no network).
# Never commit a real key.
OPENAI_API_KEY=

# ── AWS cloud sinks (OPTIONAL) ───────────────────────────────────────────
# Only needed if you explicitly construct AwsIoTSink / SiteWiseSink.
# The core pipeline and demo never read these.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_IOT_ENDPOINT=
